{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pm-zero.local/schemas/design-workflow-v2/render-manifest.schema.json",
  "title": "Design workflow v2 render manifest",
  "description": "What a renderer owes back. Semantics are strict, visuals are open: a renderer that cannot return a mapping is exploration-only and may not produce a G3 candidate.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "renderer_id", "renderer_version", "input_design_model_hash", "outputs", "screen_mapping", "element_mapping", "changed_ids", "declared_scope", "validation", "g3_capable"],
  "properties": {
    "schema_version": { "const": 1 },
    "renderer_id": { "type": "string", "minLength": 1 },
    "renderer_version": { "type": "string", "minLength": 1 },
    "input_design_model_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "change_id": { "type": "string", "pattern": "^chg-[0-9]{4,}$" },
    "outputs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "screen_mapping": { "type": "array", "items": { "$ref": "#/$defs/mappingEntry" } },
    "element_mapping": { "type": "array", "items": { "$ref": "#/$defs/mappingEntry" } },
    "changed_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^(SC|EL)-[A-Z0-9]+(-[A-Z0-9]+)*$" } },
    "declared_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_ids", "preserve_ids"],
      "properties": {
        "target_ids": { "type": "array", "items": { "type": "string" } },
        "preserve_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preflight", "rendered_layout"],
      "properties": {
        "preflight": { "type": "string", "enum": ["pass", "fail", "skipped"] },
        "rendered_layout": { "type": "string", "enum": ["pass", "fail", "skipped"] },
        "screenshots": { "type": "array", "items": { "type": "string" } }
      }
    },
    "degraded_semantics": { "type": "array", "items": { "type": "string" } },
    "g3_capable": { "type": "boolean" }
  },
  "$defs": {
    "mappingEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "locator"],
      "properties": {
        "id": { "type": "string", "pattern": "^(SC|EL)-[A-Z0-9]+(-[A-Z0-9]+)*$" },
        "locator": { "type": "string", "minLength": 1 }
      }
    }
  }
}
