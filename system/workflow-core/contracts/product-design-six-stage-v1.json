      "reviewers": 1,
      "static_only": true,
      "depends_on_stages": [
        "S3",
        "S4"
      ],
      "char_budget": 24000,
      "capability_dependencies": {
        "interface-visual-design": [
          "visual-assets"
        ]
      }
    },
    {
