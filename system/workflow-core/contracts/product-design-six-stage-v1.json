      "reviewers": 1,
      "static_only": false,
      "depends_on_stages": [
        "S4",
        "S5"
      ],
      "char_budget": 26400,
      "capability_dependencies": {
        "browser-verification": [
          "demo-implementation",
          "motion-design",
          "responsive-design"
        ]
