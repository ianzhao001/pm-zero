    {
      "id": "S5",
      "name": "高保真视觉",
      "artifacts": [
        "visual_design"
      ],
      "required_capabilities": [
        "interface-visual-design",
        "design-system-application"
      ],
      "optional_capabilities": [
        "icon-design",
        "visual-assets",
        "visual-polish"
