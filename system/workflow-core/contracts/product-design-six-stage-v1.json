      ],
      "required_capabilities": [
        "visual-direction",
        "color-typography"
      ],
      "optional_capabilities": [
        "brand-guidance",
        "visual-assets"
      ],
      "reviewers": 0,
      "static_only": true,
      "depends_on_stages": [
        "S2"
      ],
      "char_budget": 24000,
      "capability_dependencies": {
        "color-typography": [
          "visual-direction"
        ],
        "visual-assets": [
          "visual-direction",
          "color-typography"
        ]
      }
    },
    {
      "id": "S4",
      "name": "线框与交互",
      "artifacts": [
        "wireframes",
        "interaction_spec",
        "design_model"
