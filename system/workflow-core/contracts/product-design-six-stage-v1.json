{
  "schema_version": 1,
  "workflow_id": "product-design-six-stage-v1",
  "version": 1,
  "default_target_stage": "S6",
  "description": "Six user-confirmed normal product stages: goal and scenarios, MRD, visual direction, combined wireframes and interaction, visual design, and interactive Demo. Recovery and verification remain system capabilities.",
  "stages": [
    {
