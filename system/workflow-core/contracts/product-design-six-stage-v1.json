      "required_capabilities": [
        "information-architecture",
        "wireframing",
        "interaction-design",
        "state-modeling"
      ],
      "optional_capabilities": [
        "interface-copy",
        "complex-layout",
        "usability-analysis",
        "accessibility-analysis"
