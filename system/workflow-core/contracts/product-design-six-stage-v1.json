      "required_capabilities": [
        "goal-clarification",
        "delivery-planning",
        "needs-discovery",
        "scenario-analysis"
      ],
      "optional_capabilities": [
        "reference-synthesis",
        "user-research",
        "evidence-analysis"
      ],
      "reviewers": 0,
      "static_only": true,
      "depends_on_stages": [],
      "char_budget": 24000,
      "capability_dependencies": {}
    },
    {
      "id": "S2",
      "name": "MRD",
      "artifacts": [
        "mrd"
      ],
      "required_capabilities": [
        "business-modeling",
        "scope-definition",
        "mrd-writing"
      ],
      "optional_capabilities": [
        "competitor-research",
        "business-analysis"
      ],
      "reviewers": 1,
      "static_only": true,
      "depends_on_stages": [
        "S1"
      ],
      "char_budget": 24000,
      "capability_dependencies": {
        "mrd-writing": [
          "business-modeling",
          "scope-definition"
        ]
      }
    },
    {
