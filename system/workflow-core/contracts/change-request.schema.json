{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pm-zero.local/schemas/design-workflow-v2/change-request.schema.json",
  "title": "Design workflow v2 change request",
  "description": "Every modification is structured before a renderer touches anything. When the user's wording is vague, the natural-language request is turned into a candidate change scope and confirmed; the renderer never guesses the scope of a whole page.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "change_id", "request", "target_ids", "allowed_changes", "preserve_ids", "impact", "reason"],
  "properties": {
    "schema_version": { "const": 1 },
    "change_id": { "type": "string", "pattern": "^chg-[0-9]{4,}$" },
    "request": { "type": "string", "minLength": 1 },
    "target_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^(SC|EL)-[A-Z0-9]+(-[A-Z0-9]+)*$" } },
    "allowed_changes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["typography", "color", "spacing-within-target", "image", "copy", "state", "action", "local-path", "layout", "information-architecture", "screen-set"] }
    },
    "preserve_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^(SC|EL)-[A-Z0-9]+(-[A-Z0-9]+)*$" } },
    "impact": { "type": "string", "enum": ["visual", "interaction", "structural"] },
    "reason": { "type": "string", "minLength": 1 },
    "baseline_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "exploration": { "type": "boolean" }
  }
}
