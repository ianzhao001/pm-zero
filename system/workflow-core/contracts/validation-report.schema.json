{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pm-zero.local/schemas/validation-report.schema.json",
  "title": "Independent demo validation report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_version", "checker", "run_id", "environment", "subject", "baseline", "checks", "status"],
  "properties": {
    "schema_version": { "const": 1 },
    "policy_version": { "const": 2 },
    "checker": {
      "type": "object", "additionalProperties": false, "required": ["id", "version"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 } }
    },
    "run_id": { "type": "string", "minLength": 1 },
    "environment": { "type": "string", "minLength": 1 },
    "subject": {
      "type": "object", "additionalProperties": false, "required": ["outputs", "design_model_hash"],
      "properties": {
        "outputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/output" } },
        "design_model_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "baseline": {
      "oneOf": [
        { "type": "null" },
        { "type": "object", "additionalProperties": false, "required": ["artifact_id", "version", "sha256"],
          "properties": { "artifact_id": { "type": "string", "minLength": 1 }, "version": { "type": "integer", "minimum": 1 }, "sha256": { "$ref": "#/$defs/sha256" } } }
      ]
    },
    "change_id": { "type": "string", "pattern": "^chg-[0-9]{4,}$" },
    "changed_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/stableId" } },
    "preserved_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/stableId" } },
    "checks": { "type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "status", "details"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["pass", "fail", "skipped"] },
        "details": { "type": "string", "minLength": 1 }
      }
    } },
    "status": { "type": "string", "enum": ["pass", "fail"] }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "stableId": { "type": "string", "pattern": "^(SC|EL)-[A-Z0-9]+(-[A-Z0-9]+)*$" },
    "output": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/sha256" } } }
  }
}
